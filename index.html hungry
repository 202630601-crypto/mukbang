<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🍚 밥 줘!! 배고픔 긴급 구조 센터 🍚</title>
    <style>
        :root {
            --main-color: #ff6b6b;
            --accent-color: #feca57;
            --bg-color: #fff9f0;
            --card-bg: #ffffff;
            --text-color: #2d3436;
        }

        body {
            font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            max-width: 500px;
            width: 100%;
            text-align: center;
        }

        h1 {
            font-size: 2.2rem;
            color: var(--main-color);
            margin-bottom: 5px;
            text-shadow: 2px 2px 0px #ffeaa7;
        }

        .subtitle {
            font-size: 1rem;
            color: #636e72;
            margin-bottom: 25px;
        }

        .card {
            background-color: var(--card-bg);
            border-radius: 20px;
            padding: 25px 20px;
            margin-bottom: 20px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.05);
            border: 2px solid #ffeaa7;
        }

        /* 메인 버튼 스타일 */
        .btn-feed {
            background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
            color: white;
            font-size: 1.8rem;
            font-weight: 800;
            border: none;
            padding: 20px 40px;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 8px 15px rgba(255, 107, 107, 0.4);
            transition: all 0.2s ease;
            width: 100%;
            margin-top: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .btn-feed:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 12px 20px rgba(255, 107, 107, 0.5);
        }

        .btn-feed:active {
            transform: translateY(2px) scale(0.98);
        }

        /* 배고픔 게이지 */
        .hunger-meter {
            width: 100%;
            background-color: #eee;
            border-radius: 10px;
            overflow: hidden;
            height: 25px;
            margin: 15px 0;
            border: 1px solid #ddd;
        }

        .hunger-fill {
            height: 100%;
            width: 80%;
            background: linear-gradient(90deg, #feca57, #ff6b6b);
            transition: width 0.3s ease;
        }

        /* 메뉴 추천 버튼 */
        .sub-btn {
            background-color: var(--accent-color);
            color: #2d3436;
            font-size: 1rem;
            font-weight: bold;
            border: none;
            padding: 12px 20px;
            border-radius: 12px;
            cursor: pointer;
            transition: background 0.2s;
            width: 100%;
            margin-top: 10px;
        }

        .sub-btn:hover {
            background-color: #ff9f43;
        }

        .recommend-box {
            font-size: 1.5rem;
            font-weight: bold;
            color: var(--main-color);
            margin-top: 15px;
            min-height: 40px;
        }

        /* 쿵쾅거리는 애니메이션 (버튼 클릭시) */
        @keyframes bounce {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        .bounce {
            animation: bounce 0.3s ease;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>🤤 밥 주세요! 🤤</h1>
        <p class="subtitle">배고파서 현기증 난단 말이에요...</p>

        <!-- 핵심 기능: 밥 주세여 음성 출력 카드 -->
        <div class="card">
            <p style="font-size: 1.1rem; margin-top: 0;">👇 아래 버튼을 눌러 소리쳐보세요!</p>
            <button class="btn-feed" id="feedBtn" onclick="speakFeed()">
                <span>🍚</span> 밥 주세여! <span>🍚</span>
            </button>
        </div>

        <!-- 배고픔 게이지 조절 -->
        <div class="card">
            <h3 style="margin-top:0;">⚡ 현재 배고픔 지수</h3>
            <div class="hunger-meter">
                <div class="hunger-fill" id="hungerBar"></div>
            </div>
            <p id="hungerText" style="font-weight: bold; color: var(--main-color);">배고픔 지수 80% (위험 단계)</p>
            <button class="sub-btn" onclick="increaseHunger()">🔥 배고픔 지수 올리기 (+10%)</button>
        </div>

        <!-- 뭐 먹을지 모를 때 추천 기능 -->
        <div class="card">
            <h3 style="margin-top:0;">🎲 결정장애용 메뉴 추천기</h3>
            <button class="sub-btn" onclick="recommendMenu()">아무거나 골라줘!</button>
            <div class="recommend-box" id="menuResult">❓ 무엇이 나올까요?</div>
        </div>
    </div>

    <script>
        // 음성 출력 기능 (SpeechSynthesis)
        function speakFeed() {
            // 버튼 클릭 애니메이션 효과
            const btn = document.getElementById('feedBtn');
            btn.classList.add('bounce');
            setTimeout(() => btn.classList.remove('bounce'), 300);

            // 브라우저 음성 지원 여부 확인
            if ('speechSynthesis' in window) {
                // 기존에 재생 중인 음성 취소
                window.speechSynthesis.cancel();

                // "밥 주떼요" 음성 객체 생성
                const utterance = new SpeechSynthesisUtterance("밥 주떼요");
                utterance.lang = 'ko-KR'; // 한국어 설정
                utterance.pitch = 1.5;    // 음높이를 약간 올려서 톤을 귀엽게 설정 (0 ~ 2)
                utterance.rate = 1.0;     // 말하는 속도 (0.1 ~ 10)

                // 음성 재생
                window.speechSynthesis.speak(utterance);
            } else {
                alert("아쉽게도 이 브라우저는 음성 출력을 지원하지 않아요 ㅠㅠ");
            }
        }

        // 배고픔 지수 증가
        let hungerLevel = 80;
        function increaseHunger() {
            if (hungerLevel < 100) {
                hungerLevel += 10;
                document.getElementById('hungerBar').style.width = hungerLevel + '%';
                
                const hungerText = document.getElementById('hungerText');
                if (hungerLevel >= 100) {
                    hungerText.innerText = '배고픔 지수 100% 🚨 (아사 직전!! 당장 밥 줘!)';
                } else {
                    hungerText.innerText = `배고픔 지수 ${hungerLevel}% (위험 단계)`;
                }
            } else {
                speakFeed(); // 100% 넘어가면 자동으로 밥 달라고 외침
            }
        }

        // 메뉴 추천
        const menuList = [
            "🔥 엽기떡볶이", "🍗 바삭한 후라이드 치킨", "🍕 고구마 피자", 
            "🍔 더블 치즈버거", "🍜 얼큰한 라면", "🍣 모둠 초밥", 
            "🥩 육즙 가득 삼겹살", "🍲 뜨끈한 국밥", "🍝 마라탕"
        ];

        function recommendMenu() {
            const menuResult = document.getElementById('menuResult');
            let count = 0;
            
            // 룰렛 돌리는 듯한 효과
            const interval = setInterval(() => {
                const randomIndex = Math.floor(Math.random() * menuList.length);
                menuResult.innerText = menuList[randomIndex];
                count++;
                
                if (count > 10) {
                    clearInterval(interval);
                    const finalMenu = menuList[Math.floor(Math.random() * menuList.length)];
                    menuResult.innerText = "👉 " + finalMenu + " 👈";
                }
            }, 80);
        }
    </script>
</body>
</html>
